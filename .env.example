# Copy to .env and fill in. Never commit .env.

# Kraken API key used by default.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Optional: one API key per bot process.
# Kraken rejects requests on a key whose nonce is not higher than the last one
# it saw, so several processes sharing one key collide ("EAPI:Invalid nonce").
# Start a process with KRAKEN_KEY_PROFILE=HFT to make it use these instead:
# KRAKEN_API_KEY_HFT=
# KRAKEN_API_SECRET_HFT=

# Notifications (optional) — set either or both. Test with: python3 notify.py
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# CoinMarketCap, for market_sentiment.py (optional)
CMC_API_KEY=
